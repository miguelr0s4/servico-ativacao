{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.productCode",
          "matches": ".*-INDISPONIVEL$"
        }
      }
    ]
  },
  "response": {
    "status": 503,
    "headers": {
      "Retry-After": "5"
    }
  }
}
