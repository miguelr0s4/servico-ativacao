{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.productCode",
          "matches": ".*-RATELIMIT$"
        }
      }
    ]
  },
  "response": {
    "status": 429,
    "headers": {
      "Retry-After": "2"
    }
  }
}
